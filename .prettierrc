{
   "endOfLine": "lf",
   "semi": false,
   "singleQuote": false,
   "tabWidth": 2,
   "printWidth": 80,

   "overrides": [
      {
         "files": ["*.html", "*.css"],
         "options": {
            "printWidth": 100
         }
      },
      {
         "files": ["*.json"],
         "options": {
            "tabWidth": 2
         }
      }
   ]
}
