#!/usr/bin/zsh

theme-manager() {
   local CURRENT_THEME_FILE="$HOME/.config/current_theme"
   local CONFIG_DIR="$HOME/.config"
   local GTK3_CONFIG="$CONFIG_DIR/gtk-3.0/settings.ini"
   local GTK4_CONFIG="$CONFIG_DIR/gtk-4.0/settings.ini"

   # Toggle
   local current=$([ -f "$CURRENT_THEME_FILE" ] && cat "$CURRENT_THEME_FILE" || echo "dark")
   if [ "$1" = "init" ]; then
      local theme="$current"
   else
      local theme=$([ "$current" = "dark" ] && echo "light" || echo "dark")
      echo "$theme" > "$CURRENT_THEME_FILE"
   fi

   # Save and export
   export THEME_MODE="$theme"

   # GTK Theme and Icon Theme variables
   local gtk_theme=$([ "$theme" = "dark" ] && echo "Materia-dark" || echo "Materia-light")
   local icon_theme=$([ "$theme" = "dark" ] && echo "Papirus-Dark" || echo "Papirus-Light")

   # 1. Update the .ini files (for older XWayland apps)
   sed -i "s|gtk-theme-name=.*|gtk-theme-name=$gtk_theme|" "$GTK3_CONFIG"
   [ -f "$GTK4_CONFIG" ] && sed -i "s|gtk-theme-name=.*|gtk-theme-name=$gtk_theme|" "$GTK4_CONFIG"

   sed -i "s|gtk-icon-theme-name=.*|gtk-icon-theme-name=$icon_theme|" "$GTK3_CONFIG"
   [ -f "$GTK4_CONFIG" ] && sed -i "s|gtk-icon-theme-name=.*|gtk-icon-theme-name=$icon_theme|" "$GTK4_CONFIG"

   # 2. Apply globally via gsettings (for Native Wayland apps)
   gsettings set org.gnome.desktop.interface color-scheme "prefer-$theme"
   gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
   gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"

   # Live change open apps
   XSETTINGS="$HOME/.config/xsettingsd/xsettingsd.conf"
   sed -i "s|Net/ThemeName .*|Net/ThemeName \"$gtk_theme\"|" "$XSETTINGS"
   sed -i "s|Net/IconThemeName .*|Net/IconThemeName \"$icon_theme\"|" "$XSETTINGS"
   pkill -HUP xsettingsd 2>/dev/null || xsettingsd &

   # Background
   local bg_color=$([ "$theme" = "dark" ] && echo "#1E1E1E" || echo "#F7F5EA")
   swaymsg output "*" bg "$bg_color" solid_color

   # Lazygit
   sed -i "s/^\(  colorScheme:\) .*/\1 $theme/" "$CONFIG_DIR/lazygit/config.yml"

   # Delta
   git config --global delta.features "$theme"

   # FZF
   if [ "$theme" = "dark" ]; then
      fzf_opts="--ansi
      --layout=reverse
      --border=sharp
      --preview-window=border-sharp
      --info=inline-right
      --highlight-line
      --color=scrollbar:#1E1E1E
      --color=fg:#D6CFC4
      --color=fg+:#E6E3DE
      --color=bg:#1E1E1E
      --color=bg+:#303030
      --color=gutter:#303030
      --color=prompt:#579DD4
      --color=marker:#B55353
      --color=pointer:#B55353
      --color=header:#D19F66
      --color=info:#575757
      --color=hl:#72BA62
      --color=hl+:#72BA62
      --color=query:#D6CFC4
      --color=border:#5F5F5F"
   else
      fzf_opts="--ansi
      --layout=reverse
      --border=sharp
      --preview-window=border-sharp
      --info=inline-right
      --highlight-line
      --color=scrollbar:#F7F5EA
      --color=fg:#070707
      --color=fg+:#000000
      --color=bg:#F7F5EA
      --color=bg+:#C9C9BF
      --color=gutter:#C9C9BF
      --color=prompt:#0F5289
      --color=marker:#AD4B4B
      --color=pointer:#AD4B4B
      --color=header:#AE5F05
      --color=info:#707070
      --color=hl:#006C00
      --color=hl+:#006C00
      --color=query:#101010
      --color=border:#7F7F7F"
   fi
   echo "$fzf_opts" > ~/.fzfrc

   # WezTerm
   touch ~/.config/wezterm/wezterm.lua

   # Indicator for Sway
   if [ "$theme" = "dark" ]; then
      indicator="#FFFFFF"
   else
      indicator="#2E9EF4"
   fi

   sed -i "s|client.focused .*|client.focused          #181818 #131313 #FFFFFF $indicator   #181818|" "$HOME/.config/sway/config"

   # Reload Sway, Portals, and notify
   if [ "$1" != "init" ]; then
      systemctl --user restart xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-gnome
      swaymsg reload
      dunstify -r 993051 "Theme switched to $theme"
   fi
}

theme-manager "$@"
